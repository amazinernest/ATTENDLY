# PostgreSQL Database Connection
DATABASE_URL="postgresql://username:password@localhost:5432/classmark?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Secret (minimum 32 characters for AES/HMAC-SHA256)
SESSION_SECRET="your-strong-random-32-character-session-secret"

# Node Environment (development | production | test)
NODE_ENV="development"

# Email Delivery Configuration (Option A: Resend API [Recommended] OR Option B: Standard SMTP)
# Option A: Resend (Get free key at https://resend.com - 100 free emails/day)
RESEND_API_KEY=""

# Option B: Standard SMTP (SendGrid, Brevo, AWS SES, or university mail relay)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM="ClassMark <onboarding@resend.dev>"


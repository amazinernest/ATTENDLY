# PostgreSQL Database Connection
DATABASE_URL="postgresql://username:password@localhost:5432/classmark?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Secret (minimum 32 characters for AES/HMAC-SHA256)
SESSION_SECRET="your-strong-random-32-character-session-secret"

# Node Environment (development | production | test)
NODE_ENV="development"

# Email Delivery Configuration (Production SMTP or transactional provider)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM="ClassMark <noreply@youruniversity.edu.ng>"
